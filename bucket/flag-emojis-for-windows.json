{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "2.3.0",
    "description": "Adds country-flag emoji glyphs to Windows Segoe UI Emoji; requires system-wide (admin) installation.",
    "homepage": "https://github.com/Chasmical/flag-emojis-for-windows",
    "license": "MIT",
    "url": "https://github.com/Chasmical/flag-emojis-for-windows/releases/download/v2.3.0/Segoe.UI.Emoji.with.Twemoji.Flags.zip",
    "hash": "d4a924fa96576a3f247834995777295a2e92ddadabc8456fef8e7e4bdd502902",
    "pre_install": [
        "if (-not $global) { throw 'Use elevated PowerShell: scoop install -g knowsky/flag-emojis-for-windows; user installs unsupported.' }"
    ],
    "installer": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "if (-not $global) { throw 'Requires elevated PowerShell: scoop install -g knowsky/flag-emojis-for-windows' }",
            "$identity = [Security.Principal.WindowsIdentity]::GetCurrent()",
            "if (-not ([Security.Principal.WindowsPrincipal]::new($identity)).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Administrator privileges are required.' }",
            "$regPath = 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
            "$regName = 'Segoe UI Emoji (TrueType)'",
            "$originalName = 'seguiemj.ttf'",
            "$ownedPrefix = 'Segoe.UI.Emoji.with.Twemoji.Flags.scoop-'",
            "$ownedName = \"$ownedPrefix$($version).ttf\"",
            "$fontDir = Join-Path $env:WINDIR 'Fonts'",
            "$original = Join-Path $fontDir $originalName",
            "$source = Join-Path $dir 'Segoe.UI.Emoji.with.Twemoji.Flags.ttf'",
            "$target = Join-Path $fontDir $ownedName",
            "if (-not (Test-Path -LiteralPath $original -PathType Leaf)) { throw 'Missing original Segoe UI Emoji; installation refused.' }",
            "if (-not (Test-Path -LiteralPath $source -PathType Leaf)) { throw \"Missing release font: $source\" }",
            "$current = [string](Get-ItemPropertyValue -Path $regPath -Name $regName -ErrorAction Stop)",
            "$ownedPattern = '^Segoe\\.UI\\.Emoji\\.with\\.Twemoji\\.Flags\\.scoop-[0-9A-Za-z._+-]+\\.ttf$'",
            "if ($current -ine $originalName -and $current -inotmatch $ownedPattern) { throw \"Unknown system font replacement ($current). Restore it manually before installing.\" }",
            "if (Test-Path -LiteralPath $target -PathType Leaf) {",
            "    if ((Get-FileHash -LiteralPath $target -Algorithm SHA256).Hash -ine (Get-FileHash -LiteralPath $source -Algorithm SHA256).Hash) { throw \"Existing file differs from release: $target\" }",
            "}",
            "$created = $false",
            "try {",
            "    if (-not (Test-Path -LiteralPath $target)) {",
            "        Copy-Item -LiteralPath $source -Destination $target -ErrorAction Stop",
            "        $created = $true",
            "    }",
            "    if (-not ('ScoopFlagEmojiNativeV1' -as [type])) {",
            "        Add-Type -TypeDefinition @'",
            "using System;",
            "using System.Runtime.InteropServices;",
            "public static class ScoopFlagEmojiNativeV1 {",
            "    [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode)]",
            "    public static extern int AddFontResourceExW(string path, uint flags, IntPtr reserved);",
            "    [DllImport(\"user32.dll\")]",
            "    public static extern IntPtr SendMessageW(IntPtr hwnd, uint msg, IntPtr wparam, IntPtr lparam);",
            "}",
            "'@ -ErrorAction Stop",
            "    }",
            "    if ([ScoopFlagEmojiNativeV1]::AddFontResourceExW($target, 0x10, [IntPtr]::Zero) -eq 0) { throw \"Windows font registration failed: $target\" }",
            "    Set-ItemProperty -Path $regPath -Name $regName -Value $ownedName -ErrorAction Stop",
            "    [void][ScoopFlagEmojiNativeV1]::SendMessageW([IntPtr]0xFFFF, 0x001D, [IntPtr]::Zero, [IntPtr]::Zero)",
            "} catch {",
            "    $live = [string](Get-ItemPropertyValue -Path $regPath -Name $regName -ErrorAction SilentlyContinue)",
            "    if ($created -and $live -ine $ownedName) { Remove-Item -LiteralPath $target -Force -ErrorAction SilentlyContinue }",
            "    throw",
            "}",
            "if ($current -ine $originalName -and $current -ine $ownedName) { Write-Warning \"Review leftover prior Scoop font: $current\" }",
            "Write-Warning 'Restart Windows to apply the modified Segoe UI Emoji.'"
        ]
    },
    "uninstaller": {
        "script": [
            "$ErrorActionPreference = 'Stop'",
            "if (-not $global) { throw 'Only global Scoop installation is supported.' }",
            "$oldVersion = Split-Path -Path $dir -Leaf",
            "if ($oldVersion -notmatch '^[0-9A-Za-z._+-]+$') { throw \"Invalid package directory: $dir\" }",
            "$ownedName = \"Segoe.UI.Emoji.with.Twemoji.Flags.scoop-$($oldVersion).ttf\"",
            "$regPath = 'HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'",
            "$regName = 'Segoe UI Emoji (TrueType)'",
            "$originalName = 'seguiemj.ttf'",
            "$fontDir = Join-Path $env:WINDIR 'Fonts'",
            "$original = Join-Path $fontDir $originalName",
            "$target = Join-Path $fontDir $ownedName",
            "$current = [string](Get-ItemPropertyValue -Path $regPath -Name $regName -ErrorAction Stop)",
            "if ($current -ieq $ownedName) {",
            "    if (-not (Test-Path -LiteralPath $original -PathType Leaf)) { throw 'Cannot restore original Segoe UI Emoji; original font missing.' }",
            "    Set-ItemProperty -Path $regPath -Name $regName -Value $originalName -ErrorAction Stop",
            "    Write-Host 'Original Segoe UI Emoji mapping restored.'",
            "} elseif ($current -ine $originalName) {",
            "    throw \"Another font mapping is active ($current). Refusing destructive cleanup.\"",
            "}",
            "if (Test-Path -LiteralPath $target -PathType Leaf) {",
            "    try { Remove-Item -LiteralPath $target -Force -ErrorAction Stop }",
            "    catch { Write-Warning \"Owned font is still locked; inspect and remove after restart: $target\" }",
            "}",
            "Write-Warning 'Restart Windows to complete the font restoration.'"
        ]
    },
    "checkver": {
        "github": "https://github.com/Chasmical/flag-emojis-for-windows"
    },
    "autoupdate": {
        "url": "https://github.com/Chasmical/flag-emojis-for-windows/releases/download/v$version/Segoe.UI.Emoji.with.Twemoji.Flags.zip"
    },
    "notes": [
        "Global installation changes HKLM Segoe UI Emoji mapping but never overwrites the original seguiemj.ttf.",
        "Requires administrator privileges. Restart Windows after install, update, or uninstall.",
        "Do not mix with the upstream installer or another Segoe UI Emoji replacement."
    ]
}
